<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Il runtime irrobustito è obbligatorio per notarizzare. Queste eccezioni
       sono le sole che servono a Plancia, e c'è scritto perché. -->

  <!-- il pannello vocale ascolta dal microfono -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- il riepilogo e i lanci fanno partire `claude` e `codex`, che non sono
       firmati dallo stesso team -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- il server è Python: carica ed esegue codice suo a runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
